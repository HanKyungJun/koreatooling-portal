      ← 메인으로 돌아가기</a>
  </div>
</div>"""

def _auth_script(password):
    return f"""<script>
(function() {{
  if (sessionStorage.getItem('kt_auth') === '1') {{
    document.getElementById('auth-overlay').style.display = 'none'; return;
  }}
  var inp = document.getElementById('pass-input');
  inp.focus();
  inp.addEventListener('keydown', function(e) {{ if (e.key === 'Enter') checkPass(); }});
}})();
function checkPass() {{
  if (document.getElementById('pass-input').value === '{password}') {{
    sessionStorage.setItem('kt_auth', '1');
    document.getElementById('auth-overlay').style.display = 'none';
  }} else {{
    document.getElementById('pass-err').textContent = '비밀번호가 틀렸습니다.';
    document.getElementById('pass-input').value = '';
    document.getElementById('pass-input').focus();
  }}
}}
</script>"""

APPS_SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbzjgm7IhynT5CCQzX1f9M78HUN8cDwwmLj9xVNSV3lrF_TPkvPCmLFt9E7GwRYmRipA/exec'

_AJAX_JS = f"""<iframe name="hidden-target" style="display:none;"></iframe>
<script>
(function() {{
  var form = document.querySelector('form');
  form.setAttribute('action', '{APPS_SCRIPT_URL}');
  form.setAttribute('target', 'hidden-target');
  form.addEventListener('submit', function() {{
    var btn = form.querySelector('.submit-btn');
    btn.disabled = true; btn.textContent = '제출 중...';
    setTimeout(function() {{
      document.getElementById('form-wrap').style.display = 'none';
      document.getElementById('success').style.display = 'block';
    }}, 800);
  }});
}})();
</script>"""



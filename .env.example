# ============================================================
# cnc-wiki 환경변수 템플릿
# ============================================================
# 사용법:
#   1. 이 파일을 .env로 복사 (Windows: copy .env.example .env)
#   2. 각 값을 실제 값으로 변경
#   3. .env는 .gitignore로 제외되므로 git에 추적되지 않음
#
# 작성일: 2026-05-11 (보안 정리)
# 관련: SECURITY_NOTES.md
# ============================================================

# --- GitHub Pages 배포 (generate.py) ---
# GitHub Personal Access Token (Settings → Developer settings → Personal access tokens)
# 권한: repo (private이면 repo 전체, public이면 public_repo)
GITHUB_TOKEN=ghp_여기에_새_토큰_입력

# GitHub 사용자명·저장소명 (배포 대상)
GITHUB_USER=HanKyungJun
GITHUB_REPO=koreatooling-portal

# --- 직원 페이지 비밀번호 (generate.py) ---
# 화면 보호용 간단 비밀번호. 실제 인증·권한 관리 아님.
STAFF_PASS=원하는_비밀번호

# 메인 페이지에 직원 전용 섹션 표시 여부 (True/False)
SHOW_STAFF=True

# --- Google Sheets ID (app.py) ---
# 폼 제출 데이터를 모으는 구글 시트 ID
# URL: https://docs.google.com/spreadsheets/d/[이부분]/edit
FORM_SHEET_ID=실제_시트_ID_입력

# --- Google OAuth 파일명 (browse_gdrive·list_gdrive·sync_to_gdrive·upload_to_gdrive·upload_to_sheets) ---
# Google Cloud Console에서 발급한 OAuth 클라이언트 JSON 파일명 (scripts/ 폴더 기준 상대 경로)
# 예: client_secret_469311829534-xxxx.apps.googleusercontent.com.json
GOOGLE_CREDS_FILE=client_secret_여기에_파일명_입력.json

# OAuth 인증 후 저장되는 액세스 토큰 파일명 (scripts/ 폴더 기준)
GOOGLE_TOKEN_FILE=token.json

# 읽기 전용 토큰 파일 (browse_gdrive.py 전용, 일반 token.json과 별도 관리)
GOOGLE_TOKEN_READONLY_FILE=token_readonly.json
